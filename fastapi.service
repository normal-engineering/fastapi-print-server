[Unit]
Description=FastAPI Print Server
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
User=nuc
Group=nuc
WorkingDirectory=/home/nuc/fastapi-print-server
EnvironmentFile=/home/nuc/fastapi-print-server/.env

# Keep worker count modest for small print-server hardware.
ExecStart=/home/nuc/fastapi-print-server/venv/bin/gunicorn app:app --workers 2 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8080 --worker-tmp-dir /dev/shm

Restart=always
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGTERM
SyslogIdentifier=fastapi-print-server

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target